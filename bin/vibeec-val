#!/bin/bash
# VIBEE Spec Validator - Simplified Wrapper
# φ² + 1/φ² = 3 | GOLDEN KEY

VALIDATOR="/Users/playra/vibee-lang/bin/vibeec-validate"

# Check if validator exists
if [[ ! -f "$VALIDATOR" ]]; then
    echo "❌ Validator not found: $VALIDATOR"
    exit 1
fi

# Run validator with all arguments
"$VALIDATOR" "$@"
