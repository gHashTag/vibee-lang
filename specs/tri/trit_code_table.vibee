name: trit_code_table
version: "1.0.0"
language: zig
module: trit_code_table

description: |
  TritCodeTable - sacred table for encoding ASCII characters into 5-trit sequences.
  Fundamental foundation of .tri format. Without this table, .tri is useless.
  
  Encoding: 5 trits per character (3^5 = 243 > 256 ASCII)
  Trits: -1 (chaos), 0 (void), +1 (order)

types:
  Trit:
    description: "Single trit - atom of VIBEE universe"
    fields:
      value: Int  # -1, 0, +1

  TritSequence:
    description: "Sequence of 5 trits for character encoding"
    fields:
      t0: Trit  # First trit (most significant)
      t1: Trit
      t2: Trit
      t3: Trit
      t4: Trit  # Last trit (least significant)

  TritCodeTable:
    description: "Sacred table for encoding characters to trits"
    fields:
      encoding: Map[String, TritSequence]  # char -> 5 trits
      decoding: Map[TritSequence, String]  # 5 trits -> char

  CharCode:
    description: "Character code with its trit representation"
    fields:
      char: String
      ascii_value: Int
      trits: TritSequence

behaviors:
  - name: initialize_trit_code_table
    given: "Empty TritCodeTable"
    when: "Table initialization is requested"
    then: "Returns fully populated TritCodeTable for all ASCII characters"

  - name: encode_char
    given: "Character (String) and TritCodeTable"
    when: "Character encoding to trits is requested"
    then: "Returns TritSequence of 5 trits"

  - name: decode_trits
    given: "TritSequence and TritCodeTable"
    when: "Trit decoding to character is requested"
    then: "Returns character (String)"

  - name: encode_string
    given: "String and TritCodeTable"
    when: "String encoding to trit stream is requested"
    then: "Returns list of TritSequence for each character"

  - name: decode_trit_stream
    given: "List of TritSequence and TritCodeTable"
    when: "Trit stream decoding to string is requested"
    then: "Returns original string"

  - name: validate_trit_sequence
    given: "TritSequence"
    when: "Sequence validity is checked"
    then: "Returns Bool - true if all trits are in range [-1, 0, +1]"

  - name: trit_sequence_to_int
    given: "TritSequence"
    when: "Sequence is converted to integer"
    then: "Returns Int - value in ternary system"

  - name: int_to_trit_sequence
    given: "Int (0-242) and TritCodeTable"
    when: "Integer is converted to trit sequence"
    then: "Returns TritSequence"

constants:
  TRIT_NEGATIVE: -1  # Chaos
  TRIT_ZERO: 0       # Void
  TRIT_POSITIVE: 1   # Order
  
  TRITS_PER_CHAR: 5       # 5 trits per character
  MAX_TRIT_VALUE: 242     # 3^5 - 1 = 242
  ASCII_RANGE: 256         # 0-255
  
  # Special characters
  NULL_CHAR: 0
  SPACE_CHAR: 32
  NEWLINE_CHAR: 10
  TAB_CHAR: 9
