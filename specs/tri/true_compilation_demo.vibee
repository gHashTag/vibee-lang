name: true_compilation_demo
version: "1.0.0"
language: zig
module: true_compilation_demo

description: |
  DEMONSTRATION: TRUE COMPILATION from .vibee
  This spec generates REAL Zig code, not just tests

types:
  Math:
    fields:
      x: F64
      y: F64

behaviors:
  - name: add
    given: F64, F64
    when: Addition operation
    then: F64
    description: Add two floating point numbers
    implementation: |
      return a + b;

  - name: multiply
    given: F64, F64
    when: Multiplication operation
    then: F64
    description: Multiply two floating point numbers
    implementation: |
      return a * b;

constants:
  - PHI: 1.618033988749895
  - PI: 3.141592653589793

test_cases:
  - name: add_two_numbers
    input:
      a: 10.0
      b: 20.0
    expected:
      result: 30.0

  - name: multiply_numbers
    input:
      a: 3.0
      b: 4.0
    expected:
      result: 12.0

entry_points:
  - name: main
    signature: main() !void
    description: Entry point for demonstration