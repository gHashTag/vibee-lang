name: enhanced_learning_system
version: "1.0.0"
language: zig
module: enhanced_learning_system

description: Enhanced Learning System for Quantum Coder Agent - learns from outcomes

types:
  Trit:
    fields:
      value: Int8
      
  LearningConfig:
    fields:
      learning_rate: Float64
      decay_factor: Float64
      exploration_rate: Float64
      
  Outcome:
    fields:
      problem_hash: Int
      solution_hash: Int
      outcome_trit: Int8
      execution_time_ms: Int64
      performance_score: Float64
      
  LearningState:
    fields:
      total_records: Int
      successful_records: Int
      failed_records: Int
      average_success_rate: Float64

behaviors:
  - name: process_outcome
    given: Outcome, LearningConfig
    when: Solution tested success or failure
    then: Bool
    description: |
      Process testing outcome and update learning
      
      Algorithm:
      1. Find record by problem and solution hash
      2. Update outcome trit (+1 success, -1 failure, 0 unknown)
      3. Update success rate using phi-based decay
      4. Update frequency
      5. Calculate performance score
      
      Formula: new_rate = old_rate * decay + learning_rate * outcome

  - name: learn_from_outcomes
    given: []const Outcome, LearningConfig
    when: Multiple outcomes available
    then: LearningState
    description: |
      Learn from batch of outcomes
      
      Algorithm:
      1. Process each outcome
      2. Calculate aggregate statistics
      3. Update global success rate
      4. Identify patterns in failures
      5. Suggest improvements

  - name: adapt_success_rate
    given: Int, Int8, Float64, Float64
    when: Need to update success rate for record
    then: Float64
    description: |
      Adapt success rate using phi-based moving average
      
      Formula:
        - Use phi for optimal weight distribution
        - Decay factor: PHI_INVERSE = 0.618
        - New samples get higher weight
        
      Formula: rate = old_rate * decay + learning_rate * outcome

  - name: calculate_reward
    given: Int8, Float64, Int64
    when: Need to calculate reward for outcome
    then: Float64
    description: |
      Calculate reward using sacred geometry
        
      Reward components:
      - Outcome trit (+1, 0, -1)
      - Execution time (faster = better)
      - Performance score (0.0 to 1.0)
      
      Formula: reward = (outcome * PHI) + (1.0 / time) + performance

  - name: update_exploration
    given: Float64, LearningConfig
    when: Need to update exploration rate
    then: Float64
    description: |
      Update exploration rate based on success
      
      Logic:
      - High success rate -> decrease exploration
      - Low success rate -> increase exploration
      - Use golden ratio for optimal balance

  - name: generate_pattern_suggestions
    given: Int, LearningState
    when: Need to suggest new patterns
    then: []const Int
    description: |
      Generate pattern suggestions using learned data
      
      Algorithm:
      1. Identify successful patterns
      2. Find common features
      3. Generate variations
      4. Rank by expected performance

  - name: meta_learn
    given: LearningConfig, LearningState
    when: Need to optimize learning parameters
    then: LearningConfig
    description: |
      Optimize learning parameters using meta-learning
      
      Algorithm:
      1. Analyze learning performance
      2. Adjust learning rate
      3. Tune decay factor
      4. Balance exploration vs exploitation
      5. Use Fibonacci search for optimal values

constants:
  - PHI_INVERSE: 0.6180339887498949
  - DEFAULT_LEARNING_RATE: 0.1
  - DEFAULT_DECAY_FACTOR: 0.9
  - DEFAULT_EXPLORATION_RATE: 0.3
  - MIN_EXPLORATION_RATE: 0.05
  - MAX_EXPLORATION_RATE: 0.8
  - OUTCOME_SUCCESS: 1
  - OUTCOME_FAILURE: -1
  - OUTCOME_UNKNOWN: 0
  - REWARD_THRESHOLD: 0.5

tests:
  - name: test_process_outcome_success
    description: Test processing successful outcome
    
  - name: test_process_outcome_failure
    description: Test processing failed outcome
    
  - name: test_adapt_success_rate
    description: Test adapting success rate with phi-based decay
    
  - name: test_calculate_reward
    description: Test reward calculation with sacred geometry
    
  - name: test_update_exploration
    description: Test exploration rate update
    
  - name: test_generate_pattern_suggestions
    description: Test pattern suggestion generation
    
  - name: test_meta_learn
    description: Test meta-learning parameter optimization

examples:
  - name: fibonacci_learning
    input: |
      outcome: {
        problem_hash: 123456789,
        solution_hash: 987654321,
        outcome_trit: 1,
        execution_time_ms: 8,
        performance_score: 0.95
      }
      config: {learning_rate: 0.1, decay_factor: 0.9, exploration_rate: 0.3}
    output: |
      success: true
      updated_success_rate: 0.955
      reward: 1.35
      exploration_rate: 0.28

  - name: batch_learning
    input: |
      outcomes: [
        {problem_hash: 111, solution_hash: 222, outcome_trit: 1, ...},
        {problem_hash: 333, solution_hash: 444, outcome_trit: -1, ...},
        {problem_hash: 555, solution_hash: 666, outcome_trit: 1, ...}
      ]
      config: {learning_rate: 0.1, decay_factor: 0.9, exploration_rate: 0.3}
    output: |
      learning_state: {
        total_records: 3,
        successful_records: 2,
        failed_records: 1,
        average_success_rate: 0.9
      }

requirements:
  - name: fpga_compatible
    description: All learning operations must be FPGA-compatible
  
  - name: real_time_learning
    description: Learning must complete in less than 1ms per outcome
  
  - name: adaptive_parameters
    description: Learning parameters must adapt based on performance
  
  - name: phi_based_updates
    description: Success rate updates must use phi-based decay

dependencies:
  - akashic_code_records
  - trit_decision_unit
  - trit_synthesizer
  - phi-engine/src/runtime/golden_wrap
  - phi-engine/src/hashmap/phi_hash
