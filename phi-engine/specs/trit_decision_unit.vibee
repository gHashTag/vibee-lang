name: trit_decision_unit
version: "1.0.0"
language: zig
module: trit_decision_unit

description: TritDecisionUnit makes decisions based on ternary logic

types:
  DecisionInput:
    fields:
      confidence: Float64
      success_rate: Float64
      quantum_amplitude: Float64
      pattern_frequency: Int
      
  DecisionResult:
    fields:
      decision: Int8
      confidence: Float64

behaviors:
  - name: decide
    given: Float64, Float64, Float64
    when: Need to make ternary decision
    then: DecisionResult
    description: Make decision based on ternary logic

  - name: evaluate_pattern
    given: Float64, Float64, Float64
    when: Need to evaluate if pattern is good enough
    then: DecisionResult
    description: Evaluate pattern based on criteria

  - name: select_best_candidate
    given: Float64, Float64, Float64, Float64
    when: Need to select best candidate from inputs
    then: DecisionResult
    description: Select best candidate from inputs

constants:
  - CONFIDENCE_THRESHOLD: 13.0
  - SUCCESS_RATE_MINIMUM: 0.8
  - QUANTUM_AMPLITUDE_THRESHOLD: 0.5
  - WEIGHT_PHI: 1.618
  - DECISION_THRESHOLD: 0.7

tests:
  - name: test_decide_use_pattern
    description: Test decision to use existing pattern (+1)
  - name: test_decide_generate_new
    description: Test decision to generate new solution (0)
  - name: test_decide_reject
    description: Test decision to reject candidate (-1)
  - name: test_evaluate_pattern
    description: Test pattern evaluation with Fibonacci thresholds
  - name: test_select_best_candidate
    description: Test selecting best candidate

examples:
  - name: fibonacci_decision
    input: |
      confidence1: 0.95
      confidence2: 0.7
      confidence3: 0.3
    output: |
      decision: 1
      confidence: 0.95

requirements:
  - name: fpga_compatible
    description: All decision logic must be FPGA-compatible
  - name: real_time_decisions
    description: Decisions must complete in less than 1ms
  - name: ternary_logic
    description: Decisions must be ternary positive, zero, negative
  - name: golden_ratio_weighting
    description: Score calculation must use golden ratio weighting

dependencies:
  - trit_comparator
  - trit_pattern_matcher
  - phi-engine/src/core/inline_cost
  - phi-engine/src/runtime/golden_wrap
