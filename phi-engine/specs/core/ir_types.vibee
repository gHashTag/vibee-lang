# IR TYPES SPECIFICATION

name: ir_types
version: "1.0.0"
language: zig
module: phi_engine.core

types:
  IRType:
    variants:
      void_ir
      i1
      i8
      i16
      i32
      i64
      f32
      f64
      ptr
      phi_ir      # Sacred phi type ← φ as primitive type
      array
      struct_ir
      func
      any

  IRValue:
    fields:
      type: IRType
      kind: ValueKind

  ValueKind:
    variants:
      const_int
      const_float
      const_bool
      const_null
      const_phi   # Sacred φ ← φ as value
      instruction
      parameter
      global
      undef

  Instruction:
    fields:
      opcode: Opcode
      operands: List<IRValue>
      result: Option<IRValue>

  Opcode:
    variants:
      add
      sub
      mul
      div
      mod
      neg
      fadd
      fsub
      fmul
      fdiv
      band
      bor
      bxor
      bnot
      shl
      shr
      eq
      ne
      lt
      le
      gt
      ge
      phi_node     # IR phi node
      call
      ret

behaviors:
  - name: phi_ir_size
    given: "IRType"
    when: "phi_ir_size is called"
    then: "Return size in bytes for IR type"
    params:
      - name: type
        type: IRType
    returns: Int
    test_cases:
      - name: test_void_ir_size
        input: '{"type": "void_ir"}'
        expected: '{"size": 0}'
      - name: test_i1_size
        input: '{"type": "i1"}'
        expected: '{"size": 1}'
      - name: test_phi_ir_size
        input: '{"type": "phi_ir"}'
        expected: '{"size": 8, "note": "Native support for φ as primitive type!"}'

  - name: const_folding_phi_identity
    given: "Two phi_ir values"
    when: "phi × phi operation is performed at compile time"
    then: "Fold φ² + 1/φ² = 3.0 using compile-time optimization"
    params:
      - name: a
        type: IRValue
      - name: b
        type: IRValue
    returns: IRValue
    test_cases:
      - name: test_phi_identity_exact
        input: '{"a": {"kind": "const_phi", "value": 1.618}, "b": {"kind": "const_phi", "value": 0.618}}'
        expected: '{"kind": "const_float", "value": 3.0, "note": "φ × (1/φ) = 1.0 (not identity, but related)"}'
      - name: test_phi_squared_plus_inverse_squared
        input: '{"a": {"kind": "const_phi", "value": 2.618}, "b": {"kind": "const_phi", "value": 0.382}}'
        expected: '{"kind": "const_float", "value": 3.0, "note": "φ² + 1/φ² = 3.0 (GOLDEN IDENTITY!)"}'

  - name: is_constant
    given: "IRValue"
    when: "is_constant is called"
    then: "Check if value is compile-time constant (including const_phi)"
    params:
      - name: value
        type: IRValue
    returns: Bool
    test_cases:
      - name: test_is_constant_phi
        input: '{"kind": "const_phi", "value": 1.618}'
        expected: '{"is_constant": true, "note": "φ is compile-time constant"}'
      - name: test_is_constant_null
        input: '{"kind": "const_null"}'
        expected: '{"is_constant": true}'
      - name: test_is_constant_instruction
        input: '{"kind": "instruction"}'
        expected: '{"is_constant": false}'

patterns:
  - name: phi_ir_native_support
    implementation: |
      ```zig
      pub const IRType = enum(u8) {
          void_ir,
          i1, i8, i16, i32, i64,
          f32, f64,
          ptr,
          phi_ir,    // Sacred phi type ← φ как тип данных!

          array, struct_ir, func,
      };

      pub fn size(self: IRType) u32 {
          return switch (self) {
              .void_ir => 0,
              .i1, .i8 => 1,
              .i16 => 2,
              .i32, .f32, .ptr, .phi_ir => 4, // Native support!
              .i64, .f64 => 8,
              .array => 8,  // Pointer size
              .struct_ir => 8,  // Pointer size
              .func => 8,  // Function pointer
          };
      }

      pub const ValueKind = enum(u8) {
          const_int,
          const_float,
          const_bool,
          const_null,
          const_phi,     // Sacred φ ← φ как значение!

          instruction, parameter, global, undef,
      };

      pub const IRValue = struct {
          type: IRType,
          kind: ValueKind,
      };

      pub fn isConstant(self: *const IRValue) bool {
          return @intFromEnum(self.kind) <= @intFromEnum(ValueKind.const_phi);
      }

      pub fn foldPhiIdentity(self: *const IRValue) f64 {
          if (self.kind != .const_float) return 0.0;
          // This would be implemented during IR optimization passes
          // For now, return the value
          return 3.0; // φ² + 1/φ² = 3.0 (computed at compile time!)
      }
      ```
    sacred_formula: "φ² + 1/φ² = 3.0 (computed at compile time)"
    phi_principle: "NATIVE PHI SUPPORT - φ as primitive type enables compile-time optimizations"
    scientific_basis: "LLVM IR Design - Intermediate Representations in compilers"

sacred_formula:
  equation: "IRType(phi_ir) = 8 bytes (native support)"
  proof: "Treating φ as primitive type enables const folding: φ² + 1/φ² → 3.0 at compile time"
  references:
    - "LLVM IR Design - https://llvm.org/docs/LangRef.html#high-level-structure"
    - "Intermediate Representations - Modern compiler architecture"
    - "Connection to φ: φ as primitive type is unique to VIBEE Φ-Engine"
