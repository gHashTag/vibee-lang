name: trit_comparator
version: "1.0.0"
language: zig
module: trit_comparator

description: TritComparator compares two trit streams on FPGA

types:
  Trit:
    fields:
      value: Int8
      
  ComparisonResult:
    fields:
      similarity: Int8
      hamming_distance: Int
      correlation_score: Float64
      
  ComparatorConfig:
    fields:
      threshold: Float64
      window_size: Int
      use_hamming: Bool

behaviors:
  - name: compare_streams
    given: Int, Int, ComparatorConfig
    when: Two trit stream hashes need comparison
    then: ComparisonResult
    description: Compare two trit streams by hash values

constants:
  - MATCH_THRESHOLD: 0.85
  - PARTIAL_MATCH_THRESHOLD: 0.5
  - TRIT_WEIGHT_PHI: 1.618
  - MAX_STREAM_LENGTH: 1024

tests:
  - name: test_compare_streams_identical
    description: Test comparing two identical trit streams
  - name: test_compare_streams_different
    description: Test comparing completely different trit streams
  - name: test_compare_streams_partial
    description: Test comparing partially matching trit streams
  - name: test_hamming_distance
    description: Test Hamming distance calculation
  - name: test_correlation_score
    description: Test correlation score calculation

examples:
  - name: fibonacci_pattern_match
    input: |
      problem_hash: 123456789
      candidate_hash: 123456789
      config: {threshold: 0.85, window_size: 64, use_hamming: true}
    output: |
      similarity: 1
      hamming_distance: 0
      correlation_score: 0.95

requirements:
  - name: fpga_compatible
    description: All operations must be FPGA-compatible
  - name: real_time_comparison
    description: Comparison must complete in less than 1ms
  - name: deterministic_results
    description: Same inputs must always produce same outputs
  - name: golden_ratio_weighting
    description: Hamming distance must use phi-based weighting

dependencies:
  - phi-engine/src/runtime/simd_ternary
  - phi-engine/src/hashmap/phi_hash
