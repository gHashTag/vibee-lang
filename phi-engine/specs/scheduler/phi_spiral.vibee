# PHI SPIRAL SPECIFICATION

name: phi_spiral
version: "1.0.0"
language: zig
module: phi_engine.scheduler

types:
  Point2D:
    fields:
      x: Float
      y: Float

  Point3D:
    fields:
      x: Float
      y: Float
      z: Float

  PhiSpiral:
    fields:
      angle: Float
      radius: Float
      x: Float
      y: Float
      z: Float  # For 3D version

behaviors:
  - name: phi_spiral_2d
    given: "n (point number)"
    when: "phi_spiral_2d is called"
    then: "Compute 2D phi-spiral coordinates"
    params:
      - name: n
        type: Int
    returns: PhiSpiral (2D version)
    test_cases:
      - name: test_spiral_point_0
        input: '{"n": 0}'
        expected: '{"angle": 0.0, "radius": 30.0, "x": 30.0, "y": 0.0}'
      - name: test_spiral_point_1
        input: '{"n": 1}'
        expected: '{"angle": 5.083, "radius": 38.0, "x": 37.8, "y": 3.2, "note": "angle = 1 × φ × π ≈ 5.083 rad, radius = 30 + 8 × 1 = 38.0"}'
      - name: test_spiral_point_10
        input: '{"n": 10}'
        expected: '{"angle": 50.83, "radius": 110.0, "x": 69.5, "y": 85.4, "note": "angle = 10 × φ × π ≈ 50.83 rad, radius = 30 + 8 × 10 = 110.0"}'
      - name: test_spiral_golden_ratio
        input: '{"n": 1, "n_compare": 2}'
        expected: '{"ratio": "≈ φ", "note": "radius growth follows golden ratio approximately"}'

  - name: phi_spiral_3d
    given: "n (point number), z_growth (vertical growth factor)"
    when: "phi_spiral_3d is called"
    then: "Compute 3D phi-spiral coordinates (adds Z dimension)"
    params:
      - name: n
        type: Int
      - name: z_growth
        type: Float
    returns: PhiSpiral (3D version)
    test_cases:
      - name: test_spiral_3d_point_0
        input: '{"n": 0, "z_growth": 5.0}'
        expected: '{"angle": 0.0, "radius": 30.0, "x": 30.0, "y": 0.0, "z": 0.0}'
      - name: test_spiral_3d_point_5
        input: '{"n": 5, "z_growth": 5.0}'
        expected: '{"angle": 25.41, "radius": 70.0, "x": 63.2, "y": 30.1, "z": 25.0, "note": "z = 5 × 5 = 25.0"}'

patterns:
  - name: phi_spiral_computation
    implementation: |
      ```zig
      const std = @import("std");
      const math = std.math;

      const PHI: f64 = 1.618033988749895;
      const PI: f64 = 3.141592653589793;

      pub const PhiSpiral = struct {
          angle: f64,
          radius: f64,
          x: f64,
          y: f64,
          z: f64 = 0.0,
      };

      pub inline fn phiSpiral(n: u32) PhiSpiral {
          const nf: f64 = @floatFromInt(n);
          const angle = nf * PHI * PI;
          const radius = 30.0 + nf * 8.0;
          return .{
              .angle = angle,
              .radius = radius,
              .x = radius * math.cos(angle),
              .y = radius * math.sin(angle),
          };
      }

      pub inline fn phiSpiral3D(n: u32, z_growth: f64) PhiSpiral {
          const spiral = phiSpiral(n);
          return .{
              .angle = spiral.angle,
              .radius = spiral.radius,
              .x = spiral.x,
              .y = spiral.y,
              .z = nf * z_growth,
          };
      }
      ```
    sacred_formula: "θ = n × φ × π, r = 30 + 8n"
    phi_principle: "GOLDEN SPIRAL - optimizes space filling without clustering on 2D plane"
    scientific_basis: "Euclid (~300 BC) - Elements, Fibonacci (~1170-1250), Kepler (1618) - Connection to golden ratio"

sacred_formula:
  equation: "angle = n × φ × π, radius = 30 + 8n"
  proof: "φ provides optimal angular increment, creating spiral that fills plane without clustering"
  references:
    - "Euclid (~300 BC) - Elements (Book VI, Proposition 31)"
    - "Fibonacci (~1170-1250) - Fibonacci sequence"
    - "Johannes Kepler (1618) - Discovery of golden ratio connection to phyllotaxis"
    - "Golden Spiral - Wikipedia: https://en.wikipedia.org/wiki/Golden_spiral"
