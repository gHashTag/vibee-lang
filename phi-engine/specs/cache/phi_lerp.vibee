# PHI LERP SPECIFICATION

name: phi_lerp
version: "1.0.0"
language: zig
module: phi_engine.cache

types:
  Vector2D:
    fields:
      x: Float
      y: Float

  Vector3D:
    fields:
      x: Float
      y: Float
      z: Float

behaviors:
  - name: phi_lerp_2d
    given: "Vector2D a, Vector2D b, Float t (0..1)"
    when: "phi_lerp_2d is called"
    then: "Interpolate between a and b using phi_lerp: t^PHI_INV"
    params:
      - name: a
        type: Vector2D
      - name: b
        type: Vector2D
      - name: t
        type: Float
    returns: Vector2D
    test_cases:
      - name: test_lerp_start
        input: '{"a": {"x": 0, "y": 0}, "b": {"x": 10, "y": 0}, "t": 0.0}'
        expected: '{"x": 0.0, "y": 0.0}'  # At t=0, return a
      - name: test_lerp_end
        input: '{"a": {"x": 0, "y": 0}, "b": {"x": 10, "y": 0}, "t": 1.0}'
        expected: '{"x": 10.0, "y": 0.0}'  # At t=1, return b
      - name: test_lerp_mid_phi
        input: '{"a": {"x": 0, "y": 0}, "b": {"x": 10, "y": 0}, "t": 0.618}'
        expected: '{"x": 6.18033988749895, "y": 0.0, "note": "t = PHI_INV = 0.618, result = a + (b-a) × 0.618 = 6.180"}'
      - name: test_lerp_smoothness
        input: '{"a": {"x": 0, "y": 0}, "b": {"x": 10, "y": 0}, "t": 0.5}'
        expected: '{"x": 6.180, "y": 0.0, "note": "Phi-lerp is non-linear (t^0.618), more smooth than linear (t^1.0) = 5.0"}'

  - name: phi_lerp_3d
    given: "Vector3D a, Vector3D b, Float t (0..1)"
    when: "phi_lerp_3d is called"
    then: "Interpolate between a and b in 3D using phi_lerp"
    params:
      - name: a
        type: Vector3D
      - name: b
        type: Vector3D
      - name: t
        type: Float
    returns: Vector3D
    test_cases:
      - name: test_lerp_3d_identity
        input: '{"a": {"x": 0, "y": 0, "z": 0}, "b": {"x": 0, "y": 0, "z": 0}, "t": 0.5}'
        expected: '{"x": 0.0, "y": 0.0, "z": 0.0}'
      - name: test_lerp_3d_mid
        input: '{"a": {"x": 0, "y": 0, "z": 0}, "b": {"x": 10, "y": 10, "z": 10}, "t": 0.618}'
        expected: '{"x": 6.180, "y": 6.180, "z": 6.180, "note": "3D interpolation with same phi factor"}'

patterns:
  - name: phi_lerp_interpolation
    implementation: |
      ```zig
      const std = @import("std");
      const math = std.math;

      const PHI: f64 = 1.618033988749895;
      const PHI_INV: f64 = 1.0 / PHI; // = 0.618033988749895

      fn phi_lerp(a: f64, b: f64, t: f64) f64 {
          const phi_t = math.pow(f64, t, PHI_INV);
          return a + (b - a) * phi_t;
      }

      fn phi_lerp_2d(a: Vector2D, b: Vector2D, t: f64) Vector2D {
          return .{
              .x = phi_lerp(a.x, b.x, t),
              .y = phi_lerp(a.y, b.y, t),
          };
      }

      fn phi_lerp_3d(a: Vector3D, b: Vector3D, t: f64) Vector3D {
          return .{
              .x = phi_lerp(a.x, b.x, t),
              .y = phi_lerp(a.y, b.y, t),
              .z = phi_lerp(a.z, b.z, t),
          };
      }
      ```
    sacred_formula: "interpolated = a + (b - a) × t^(1/φ)"
    phi_principle: "SMOOTH INTERPOLATION - non-linear derivative for smoother transitions"
    scientific_basis: "Smooth Interpolation Theory - provides smoother transitions than linear interpolation"

sacred_formula:
  equation: "lerp_φ(a, b, t) = a + (b - a) × t^(1/φ)"
  proof: "PHI_INV = 0.618 provides non-linear interpolation with smoother transitions than linear (t^1.0)"
  references:
    - "Smooth Interpolation Theory - Mathematical background for non-linear interpolation"
    - "Connection to φ: PHI_INV = 0.618 = (1/φ) - (1/φ)² + ..."
